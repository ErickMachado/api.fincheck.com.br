{
  "name": "@fincheck/backend",
  "private": true,
  "description": "API REST do Fincheck e laboratório pessoal para aprender engenharia back-end. Feito com Node.js e TypeScript 💚",
  "license": "MIT",
  "author": "Erick Machado <erick.gsmachado@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:ErickMachado/api.fincheck.com.br.git"
  },
  "scripts": {
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:commit": "commitlint --edit $1",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "start:dev": "tsx watch --env-file .env src/main/main.ts",
    "test:e2e": "vitest run --dir tests/e2e",
    "test:e2e:watch": "vitest --dir tests/e2e"
  },
  "dependencies": {
    "fastify": "5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "26.1.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "readme": "https://github.com/ErickMachado/api.fincheck.com.br?tab=readme-ov-file"
}
