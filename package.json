{
  "name": "@fincheck/backend",
  "private": true,
  "description": "API REST do Fincheck e laboratório pessoal para aprender engenharia back-end. Feito com Node.js e TypeScript 💚",
  "license": "MIT",
  "author": "Erick Machado <erick.gsmachado@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:ErickMachado/api.fincheck.com.br.git"
  },
  "scripts": {
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:commit": "commitlint --edit $1",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "migration:create": "node-pg-migrate create --migrations-dir src/infra/database/migrations -j sql",
    "migration:down": "dotenv -e .env -- node-pg-migrate down --migrations-dir src/infra/database/migrations",
    "migration:up": "dotenv -e .env -- node-pg-migrate up --migrations-dir src/infra/database/migrations",
    "start:dev": "tsx watch --env-file .env src/main/main.ts",
    "test": "dotenv -e .env.test -- vitest run --dir tests",
    "test:watch": "dotenv -e .env.test -- vitest --dir tests"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@react-email/components": "1.0.12",
    "fastify": "5.10.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "8.0.11",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulidx": "2.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@faker-js/faker": "10.5.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.1.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv-cli": "11.0.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "readme": "https://github.com/ErickMachado/api.fincheck.com.br?tab=readme-ov-file"
}
