{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": [
      "ES2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "NodeNext",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024"
  }
}
