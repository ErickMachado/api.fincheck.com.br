{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": [
      "ES2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "NodeNext",
    "moduleResolution": "Node16",
    "paths": {
      "@application/*": ["./src/application/*"],
      "@common/*": ["./src/common/*"],
      "@domain/*": ["./src/domain/*"],
      "@infra/*": ["./src/infra/*"],
      "@main/*": ["./src/main/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024"
  }
}
